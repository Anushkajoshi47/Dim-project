# Copy to backend/.env for local development.
# In deployment set these in the hosting platform's environment settings instead.

# Local dev points at the docker-compose Postgres (host port 5544).
# In deployment this is the managed database's connection string.
DATABASE_URL="postgresql://somaiya:somaiya@localhost:5544/somaiyasat?schema=public"

# Hosting platforms set PORT themselves; leave it for local dev only.
PORT=4000

# Browser origins allowed to reach the API and the socket.io stream.
# Comma-separate for more than one, e.g.
#   CORS_ORIGIN="https://somaiyasat-frontend.onrender.com,https://kjs-srs-01.vercel.app"
CORS_ORIGIN="http://localhost:3000"

# Mission epoch. Blank = process start time.
SIM_EPOCH=""

# Simulation speed multiplier (1 = real time, 30 = one orbit in ~3 min).
SIM_SPEED=30
